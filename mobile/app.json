{
  "expo": {
    "name": "Rebel Trading",
    "slug": "rebel-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rebel",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.rebeltrading.aitradecoach",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Rebel uses your microphone so you can ask questions by voice while trading.",
        "NSSpeechRecognitionUsageDescription": "Rebel uses speech recognition to understand your voice questions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "co.rebeltrading.aitradecoach",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Rebel uses your microphone so you can ask questions by voice while trading."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0a2a559b-e5b1-46c1-80fb-0e8da7473ba5"
      }
    },
    "owner": "xx_gotham"
  }
}
