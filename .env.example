# Copy to .env and fill in. Never commit the real file.
#
# Every value here is optional. With none of them set, Rebel runs on a local
# SQLite file with synthetic market data and the template thesis generator —
# the whole pipeline works, it just isn't analysing the real market.

# ---- Database ----
# Omit for SQLite (no Docker needed). Set for Postgres via docker-compose.
# ConnectionStrings__Rebel=Host=localhost;Port=5432;Database=rebel;Username=rebel;Password=rebel

# ---- Market data and news: Alpaca ----
# Free at https://alpaca.markets — a paper account includes IEX data and news.
# Rebel__Alpaca__KeyId=
# Rebel__Alpaca__SecretKey=
# "iex" is included free; "sip" requires a paid data subscription.
# Rebel__Alpaca__Feed=iex

# ---- Thesis generation: OpenAI ----
# Rebel__OpenAi__ApiKey=
# Rebel__OpenAi__Model=gpt-4o-2024-08-06

# ---- Scheduling ----
# Off by default. Turn on to run the pre-market brief and post-close grading.
# Rebel__Pipeline__EnableScheduledRuns=true
# Rebel__Pipeline__MorningRunCron=15 7 * * 1-5
# Rebel__Pipeline__GradingCron=30 17 * * 1-5

# ---- Risk (paper sizing) ----
# Rebel__Risk__AccountEquity=100000
# Rebel__Risk__RiskPerTradePercent=1.0
