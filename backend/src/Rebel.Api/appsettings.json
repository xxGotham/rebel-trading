{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Rebel": "Data Source=rebel.db"
  },
  "Rebel": {
    "Providers": {
      "MarketData": "auto",
      "News": "auto",
      "Thesis": "auto"
    },
    "Alpaca": {
      "KeyId": "",
      "SecretKey": "",
      "DataBaseUrl": "https://data.alpaca.markets",
      "Feed": "iex",
      "Adjustment": "split",
      "MaxSymbolsPerRequest": 100
    },
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-2024-08-06",
      "Temperature": 0.4,
      "MaxOutputTokens": 4000,
      "TimeoutSeconds": 120,
      "RetryOnNumberViolation": true
    },
    "Pipeline": {
      "HistoryDays": 400,
      "CandidateCount": 15,
      "MaxRecommendations": 3,
      "NewsLookbackHours": 36,
      "NewsPerSymbol": 5,
      "MinimumUniverseCoverage": 20,
      "MorningRunCron": "15 7 * * 1-5",
      "GradingCron": "30 17 * * 1-5",
      "EnableScheduledRuns": false
    },
    "Scoring": {
      "Version": "score-v1",
      "Momentum20": 1.0,
      "RelativeStrength": 1.5,
      "SectorStrength": 0.5,
      "RelativeVolume": 1.25,
      "Gap": 0.75,
      "TrendQuality": 0.75,
      "ProximityToHigh": 1.0,
      "VolatilityPenalty": -0.5,
      "OverboughtPenalty": -0.5,
      "MinimumScore": 55,
      "Filters": {
        "MinPrice": 5,
        "MinAverageDollarVolume": 20000000,
        "MinBars": 60,
        "MaxGapPercent": 8,
        "RequireAboveSma50": true,
        "MaxRsi": 80,
        "MaxAtrPercent": 12
      }
    },
    "Risk": {
      "AccountEquity": 100000,
      "RiskPerTradePercent": 1.0,
      "MaxPositionPercent": 20,
      "StopAtrMultiple": 1.5,
      "TargetAtrMultiple": 3.0,
      "EntryBandAtrMultiple": 0.25,
      "MinimumRiskReward": 1.75,
      "MinHoldingDays": 1,
      "MaxHoldingDays": 10
    },
    "Cors": {
      "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
    }
  }
}
